#!/usr/bin/env bash
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
if ! printf '%s\n' "$staged" | grep -qE '^(go\.mod|go\.sum|flake\.nix|flake\.lock)$'; then
  exit 0
fi

if ! command -v nix >/dev/null 2>&1; then
  echo "pre-commit: nix not found in PATH; skipping flake.nix / vendorHash check" >&2
  exit 0
fi

echo "pre-commit: validating flake.nix and Go vendorHash..."
nix flake check --no-build
nix build --no-link .#default.goModules
echo "pre-commit: flake.nix and vendorHash verified."
